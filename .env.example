# Copy to .env.local and fill in. Never commit a real value.
# Every key here is documented; if you add one, add it here too.

# ── Database ───────────────────────────────────────────────────────────
# Atlas in every environment. Local dev uses a single-node REPLICA SET,
# not a standalone mongod — transactions fail on standalone. See CLAUDE.md.
MONGODB_URI="mongodb://127.0.0.1:27017/kurasikapa?replicaSet=rs0"
MONGODB_DB="kurasikapa"

# ── Auth (Better Auth — ADR-0004) ──────────────────────────────────────
# Signs session cookies. Minimum 32 chars, enforced at boot.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""
APP_URL="http://localhost:3000"

# Social sign-in. A provider is configured only when BOTH values are set —
# half-configured renders a button that fails at the redirect.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ── AI (ADR-0005) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ── Media (ADR-0006 — R3) ──────────────────────────────────────────────
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_WEBHOOK_SECRET=""

# ── Go service ─────────────────────────────────────────────────────────
MEDIA_SVC_URL="http://localhost:8080"
MEDIA_SVC_TOKEN=""

# ── Email (R2) ─────────────────────────────────────────────────────────
RESEND_API_KEY=""

# ── Payments (R4) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYSTACK_SECRET_KEY=""

# ── Social (R2) ────────────────────────────────────────────────────────
META_APP_ID=""
META_APP_SECRET=""
META_PAGE_ACCESS_TOKEN=""

# ── Quality (optional — CI skips Sonar when unset) ─────────────────────
SONAR_TOKEN=""
SONAR_HOST_URL="https://sonarcloud.io"

# Shared secret for the scheduled-publication cron (/api/cron/publish-due).
# Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`.
# The route REFUSES every request when this is unset — an endpoint that
# publishes articles must not fall open because a variable is missing.
# Generate with: openssl rand -hex 32
CRON_SECRET=
