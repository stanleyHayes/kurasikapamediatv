# Copy to .env.local and fill in. Never commit a real value.
# Every key here is documented; if you add one, add it here too.

# ── Database ───────────────────────────────────────────────────────────
# Atlas in every environment. Local dev uses a single-node REPLICA SET,
# not a standalone mongod — transactions fail on standalone. See CLAUDE.md.
MONGODB_URI="mongodb://127.0.0.1:27017/kurasikapa?replicaSet=rs0"
MONGODB_DB="kurasikapa"

# ── Auth (Better Auth — ADR-0004) ──────────────────────────────────────
# Signs session cookies. Minimum 32 chars, enforced at boot.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""
APP_URL="http://localhost:3000"

# Social sign-in. A provider is configured only when BOTH values are set —
# half-configured renders a button that fails at the redirect.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ── AI (ADR-0005) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ── Media (ADR-0006 — R3) ──────────────────────────────────────────────
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_WEBHOOK_SECRET=""

# ── Go API (ADR-0009) ──────────────────────────────────────────────────
# Private backend. Next forwards the signed-in user id on X-Kurasikapa-User.
# Leave unset to keep create-draft on the in-process TypeScript use cases.
API_URL="http://localhost:8080"

# ── Email (R2) ─────────────────────────────────────────────────────────
# Unset or empty fails closed: subscribe stores pending then refuses, so a
# confirmation is never reported as sent when nothing left the building.
RESEND_API_KEY=""

# ── Web Push (R2) ──────────────────────────────────────────────────────
# Unset keys fail closed: the opt-in is hidden and send throws.
# Raw P-256 keys, base64url. Generate with node:crypto — do not add web-push.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ── Payments (R4) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYSTACK_SECRET_KEY=""

# ── Social (R2) ────────────────────────────────────────────────────────
# The send path is wired and fail-closed: unset token → every due post fails
# visibly and retries. Live Graph calls also need page id (Facebook) and
# Instagram user id. App review is still required before anything actually
# lands on a page.
META_APP_ID=""
META_APP_SECRET=""
META_PAGE_ACCESS_TOKEN=""
META_PAGE_ID=""
META_IG_USER_ID=""

# ── CAPTCHA (optional — Better Auth Turnstile) ─────────────────────────
# Both must be set or the widget and the plugin stay off. Half-configured
# would 400 every sign-in, including Playwright.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ── Analytics (optional — GDPR gated) ──────────────────────────────────
# gtag loads only after the reader accepts the consent banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ── Quality (optional — CI skips Sonar when unset) ─────────────────────
SONAR_TOKEN=""
SONAR_HOST_URL="https://sonarcloud.io"

# Shared secret for scheduled crons (/api/cron/publish-due and
# /api/cron/publish-due-posts). Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`. The routes REFUSE every request
# when this is unset — an endpoint that publishes must not fall open.
# Generate with: openssl rand -hex 32
CRON_SECRET=
