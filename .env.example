# Copy to .env.local and fill in. Never commit a real value.
# Every key here is documented; if you add one, add it here too.

# ── Database ───────────────────────────────────────────────────────────
# Atlas in every environment. Local dev uses a single-node REPLICA SET,
# not a standalone mongod — transactions fail on standalone. See CLAUDE.md.
MONGODB_URI="mongodb://127.0.0.1:27017/kurasikapa?replicaSet=rs0"
MONGODB_DB="kurasikapa"

# ── Auth (Better Auth — ADR-0004) ──────────────────────────────────────
# Signs session cookies. Minimum 32 chars, enforced at boot.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The origin of THIS deployment. Different per app: the public site and the
# studio are separate deployments (ADR-0011).
APP_URL="http://localhost:3000"

# ── The two deployables (ADR-0011) ─────────────────────────────────────
# IMPORTANT: every key in this block is optional, and an EMPTY value is not
# the same as unset — zod validates the empty string and rejects it, so
# `SITE_URL=` breaks boot where a missing line would not. Comment a key out
# rather than blanking it.
#
# `pnpm dev` runs the site on :3000 and the studio on :3001, which is a
# split-origin deployment — so the local values below are set, not omitted.
# Cookies ignore the port, so sign-in still hands over without COOKIE_DOMAIN.
#
#   SITE_URL     origin of the public site
#   STUDIO_URL   origin AND basePath of the studio (the /studio suffix is its
#                basePath, not a typo)
#
# In the production SAME-ORIGIN shape — the studio rewritten onto /studio of
# the public domain — comment both out and let APP_URL answer for both.
SITE_URL="http://localhost:3000"
STUDIO_URL="http://localhost:3001/studio"

# Parent domain for the session cookie, e.g. ".kurasikapa.tv".
# REQUIRED when the studio has its own host in production: without it the
# site's cookie never reaches the studio subdomain and an editor loops back to
# sign-in with no error anywhere. Leave commented locally — localhost cookies
# already cross ports.
# COOKIE_DOMAIN=".kurasikapa.tv"

# Authorises the studio → site cache-invalidation call. Next scopes cache tags
# to one deployment, so a publish in the studio cannot refresh the public
# site's cache directly; it posts the tags to SITE_URL/api/revalidate instead.
# Set the SAME value on BOTH deployments. Minimum 32 chars.
#   openssl rand -base64 32
# Unset: the endpoint refuses every request, and a publish raises a reported
# failure rather than quietly leaving the site stale.
REVALIDATE_SECRET="local-development-revalidate-secret-0123456789"

# Social sign-in. A provider is configured only when BOTH values are set —
# half-configured renders a button that fails at the redirect.
# Omit unavailable providers entirely in hosted environments. Empty strings
# are retained here only as obvious local-development placeholders.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# Apple signs its OAuth client secret from these four values. It does not use
# APPLE_CLIENT_ID / APPLE_CLIENT_SECRET.
APPLE_SERVICES_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# ── AI (ADR-0005) ──────────────────────────────────────────────────────
# Commented, not blank: the schema is `.min(1).optional()`, so an empty string
# FAILS validation where a missing key is accepted. Uncomment and fill in.
# ANTHROPIC_API_KEY=""

# ── Media (ADR-0010 — R3) ──────────────────────────────────────────────
# Amazon IVS powers the Studio Go Live control room and public HLS player.
# The two AWS credentials must belong to an IAM principal limited to IVS
# CreateChannel/CreateStreamKey/DeleteChannel in this region. Unset credentials
# fail closed: pages still render, but Studio refuses to provision a channel.
# The stream key is returned once to the operator and is never stored.
AWS_REGION="eu-west-3"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# Required for Go Live: IVS automatically writes every completed broadcast to
# the configured private S3 destination before an editor publishes a replay.
# AWS_IVS_RECORDING_CONFIGURATION_ARN="arn:aws:ivs:eu-west-1:123456789012:recording-configuration/xxxxxxxx"
# EventBridge and MediaConvert turn completed private IVS HLS into a private
# Cloudinary-ready MP4. Both buckets must be private and in AWS_IVS_REGION;
# allowlist only the processing bucket for Cloudinary reads.
AWS_IVS_REGION="eu-west-1"
# AWS_IVS_RECORDING_BUCKET="kurasikapa-ivs-recordings"
# AWS_MEDIACONVERT_OUTPUT_BUCKET="kurasikapa-media-processing"
# AWS_MEDIACONVERT_ROLE_ARN="arn:aws:iam::123456789012:role/kurasikapa-mediaconvert"
# AWS_MEDIACONVERT_JOB_TEMPLATE="kurasikapa-ivs-hls-to-mp4"
# IVS_RECORDING_WEBHOOK_SECRET="generate-a-separate-long-random-secret"
# The Go API uses a separate least-privilege IAM principal for Polly plus a
# private, same-region S3 staging bucket. Generative EN/FR voices are available
# in London; completed files are promoted to Cloudinary and removed from S3.
AWS_POLLY_REGION="eu-west-2"
# AWS_POLLY_OUTPUT_BUCKET=""
# Cloudinary powers signed direct uploads for images, recordings, VOD,
# podcasts, captions and transcripts. These three values belong on the Go API
# only; never expose the API secret to either browser deployment.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Go API (ADR-0009) ──────────────────────────────────────────────────
# Private backend. Next forwards the signed-in user id on X-Kurasikapa-User.
# Leave unset to keep create-draft on the in-process TypeScript use cases.
API_URL="http://localhost:8080"

# ── Email (R2) ─────────────────────────────────────────────────────────
# Unset or empty fails closed: subscribe stores pending then refuses, so a
# confirmation is never reported as sent when nothing left the building.
# Contact form uses the same mailer; unset RESEND → honest delivery failure.
RESEND_API_KEY=""
# Newsroom inbox for the public contact form (defaults to Yahoo newsroom).
CONTACT_TO_EMAIL="kurasikapamediatv@yahoo.com"

# ── Web Push (R2) ──────────────────────────────────────────────────────
# Unset keys fail closed: the opt-in is hidden and send throws.
# Raw P-256 keys, base64url. Generate with node:crypto — do not add web-push.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ── Payments (R4) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYSTACK_SECRET_KEY=""

# ── Social (R2) ────────────────────────────────────────────────────────
# The send path is wired and fail-closed: unset token → every due post fails
# visibly and retries. Live Graph calls also need page id (Facebook) and
# Instagram user id. App review is still required before anything actually
# lands on a page.
META_APP_ID=""
META_APP_SECRET=""
META_PAGE_ACCESS_TOKEN=""
META_PAGE_ID=""
META_IG_USER_ID=""

# ── CAPTCHA (optional — Better Auth Turnstile) ─────────────────────────
# Both must be set or the widget and the plugin stay off. Half-configured
# would 400 every sign-in, including Playwright.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ── Analytics (optional — GDPR gated) ──────────────────────────────────
# gtag loads only after the reader accepts the consent banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ── Quality (optional — CI skips Sonar when unset) ─────────────────────
SONAR_TOKEN=""
SONAR_HOST_URL="https://sonarcloud.io"

# Shared secret for scheduled crons (/api/cron/publish-due and
# /api/cron/publish-due-posts). Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`. The routes REFUSE every request
# when this is unset — an endpoint that publishes must not fall open.
# Generate with: openssl rand -hex 32
# Commented, not blank: the schema is `.min(32).optional()`, so an empty string
# FAILS validation where a missing key is accepted.
#
# OPTIONAL LOCALLY, REQUIRED IN PRODUCTION — see the block below.
# CRON_SECRET=

# ── Required in production, optional everywhere else ───────────────────
#
# `optional()` in the schema means "a laptop boots without it", not "a
# deployment works without it". These four are checked once at server start
# by composition/production-readiness.ts, which REFUSES to come up rather
# than serve a site that looks healthy and quietly does not publish:
#
#   CRON_SECRET        every schedule is inert — scheduled publication, RSS
#                      ingest and both digests 404 and report nothing
#   REVALIDATE_SECRET  publishing cannot refresh the public site, so breaking
#                      news waits for the cache to expire on its own
#   APP_URL            UNSET, so every canonical, OpenGraph tag, e-mail link
#                      and cross-deployment redirect falls back to localhost.
#                      Set explicitly to a loopback address it is taken as a
#                      server under test — which is how the Playwright suite
#                      serves production builds — and the check stands down.
#   COOKIE_DOMAIN      split-origin only (different HOSTNAMES — a port does
#                      not count, cookies ignore it). Without it the studio
#                      never sees the session the site issued: ADR-0011 § 4.
#
# The check runs at BOOT, not at build: `next build` sets NODE_ENV=production
# with none of these set, by design, and a red build would report a
# deployment-config gap to the wrong person.
