{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:31923/en",
        "http://127.0.0.1:31923/en/articles/budget-2026-explained"
      ],
      "startServerCommand": "pnpm --filter @kurasikapa/web exec next start --hostname 127.0.0.1 --port 31923",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 60000,
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-gpu"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.5 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
