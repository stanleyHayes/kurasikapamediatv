{
  "extends": "../config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "types": ["node"],
    "paths": {
      "@kurasikapa/domain": ["../domain/src/index.ts"],
      "@kurasikapa/domain/testing": ["../domain/src/testing/builders.ts"],
      "@kurasikapa/application": ["../application/src/index.ts"],
      "@kurasikapa/application/testing": ["../application/src/testing/index.ts"],
      "@kurasikapa/config/vitest": ["../config/vitest.base.ts"]
    }
  },
  "include": ["src/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
