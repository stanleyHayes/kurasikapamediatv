{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      // Strict env mode filters the process env; both app builds validate
      // MONGODB_URI and BETTER_AUTH_SECRET at prerender (composition/env.ts),
      // so they must be allowed through. passThroughEnv, not env: the values
      // are runtime config and must not change the build cache hash.
      //
      // The URL trio is prerendered into cross-app links (sign-in, the studio
      // guard's redirects), so a build without them silently emits localhost.
      "passThroughEnv": [
        "MONGODB_URI",
        "MONGODB_DB",
        "BETTER_AUTH_SECRET",
        "APP_URL",
        "SITE_URL",
        "STUDIO_URL",
        "COOKIE_DOMAIN",
        "REVALIDATE_SECRET",
        "CRON_SECRET",
        "API_URL",
        "CONTACT_TO_EMAIL",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "ANTHROPIC_API_KEY",
        "AWS_REGION",
        "LIVE_VIDEO_PROVIDER",
        "OVENMEDIA_API_URL",
        "OVENMEDIA_API_TOKEN",
        "OVENMEDIA_INGEST_URL",
        "OVENMEDIA_PLAYBACK_URL",
        "OVENMEDIA_SIGNING_SECRET",
        "OVENMEDIA_KEY_LIFETIME_SECONDS",
        "OVENMEDIA_MAX_BROADCAST_SECONDS"
      ]
    },
    // `Route` (typedRoutes) is a narrowed union only once Next has written
    // .next/types/routes.d.ts. Without it the type widens to `string`, and
    // type-aware lint rules read a necessary cast as a redundant one — which
    // is exactly how `pnpm lint` came to pass locally, off a stale build, and
    // fail on CI's clean checkout. typegen is the cheap half of `next build`:
    // no bundling, no database, no env. `lint` runs it first so the gate
    // answers the same question everywhere.
    "typegen": {
      "outputs": [".next/types/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
